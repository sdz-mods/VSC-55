@ECHO OFF
ECHO.
ECHO   VSC-55 - MIDI sound module for Windows 98
ECHO   Installs into C:\VSC-55. Existing ROMs and settings are kept.
ECHO   The tray panel starts STOPPED with Windows by default.
ECHO   Close games before continuing. VSC-55 will be stopped automatically.
IF "%1"=="/quiet" GOTO begin
PAUSE
:begin
IF NOT EXIST MIDIREG.EXE GOTO missing
MIDIREG.EXE stop
IF ERRORLEVEL 1 GOTO failed
MIDIREG.EXE check
IF ERRORLEVEL 1 GOTO failed
FOR %%F IN (VSC55.EXE VSCCFG.EXE VSC55.DRV LICENSE.TXT) DO IF NOT EXIST %%F GOTO missing
FOR %%F IN (README.TXT REMOVE.BAT UNINSTALL.BAT VSC55.INI) DO IF NOT EXIST %%F GOTO missing
FOR %%F IN (PANEL.BMP PANELART.TXT CREDITS.TXT LICENSES.MD) DO IF NOT EXIST %%F GOTO missing
IF NOT EXIST LICENSES\NUL GOTO missing
IF NOT EXIST C:\VSC-55\NUL MD C:\VSC-55
IF NOT EXIST C:\VSC-55\NUL GOTO failed
IF EXIST C:\VSC-55\INSTALL.OK DEL C:\VSC-55\INSTALL.OK
COPY /Y VSC55.EXE C:\VSC-55\VSC55.EXE >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y VSCCFG.EXE C:\VSC-55\VSCCFG.EXE >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y MIDIREG.EXE C:\VSC-55\MIDIREG.EXE >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y VSC55.DRV C:\VSC-55\VSC55.DRV >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y LICENSE.TXT C:\VSC-55\LICENSE.TXT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y README.TXT C:\VSC-55\README.TXT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y REMOVE.BAT C:\VSC-55\REMOVE.BAT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y UNINSTALL.BAT C:\VSC-55\UNINSTALL.BAT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y PANEL.BMP C:\VSC-55\PANEL.BMP >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y PANELART.TXT C:\VSC-55\PANELART.TXT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y CREDITS.TXT C:\VSC-55\CREDITS.TXT >NUL
IF ERRORLEVEL 1 GOTO failed
COPY /Y LICENSES.MD C:\VSC-55\LICENSES.MD >NUL
IF ERRORLEVEL 1 GOTO failed
XCOPY LICENSES C:\VSC-55\LICENSES\ /E /I /Y >NUL
IF ERRORLEVEL 1 GOTO failed
IF EXIST C:\VSC-55\VSC55.INI GOTO keepini
COPY /Y VSC55.INI C:\VSC-55\VSC55.INI >NUL
IF ERRORLEVEL 1 GOTO failed
:keepini
IF NOT EXIST C:\VSC-55\ROMS\NUL MD C:\VSC-55\ROMS
IF NOT EXIST C:\VSC-55\ROMS\MK1\NUL MD C:\VSC-55\ROMS\MK1
IF NOT EXIST C:\VSC-55\ROMS\MK2\NUL MD C:\VSC-55\ROMS\MK2
C:\VSC-55\MIDIREG.EXE install >C:\VSC-55\INSTALL.LOG
IF ERRORLEVEL 1 GOTO failed
C:\VSC-55\MIDIREG.EXE startup-on >>C:\VSC-55\INSTALL.LOG
IF ERRORLEVEL 1 GOTO failed
ECHO PASS >C:\VSC-55\INSTALL.OK
ECHO.
ECHO   Installation complete. Please reboot Windows.
ECHO   Open the tray panel, select your ROM folder, then press Start.
GOTO end
:missing
ECHO   Missing installation files. Extract the entire package and run
ECHO   INSTALL.BAT from that folder, not from C:\VSC-55.
GOTO end
:failed
ECHO   Installation did not finish. Check the messages above and
ECHO   C:\VSC-55\INSTALL.LOG if present. Correct the problem and retry.
:end
IF "%1"=="/quiet" GOTO done
PAUSE
:done
